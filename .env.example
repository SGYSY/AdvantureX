# Application
API_KEY=
DATABASE_PATH=./wingman.db
DEFAULT_DELAY_SECONDS=8
USER_PHONE_NUMBER=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Comma-separated browser origins allowed to call this backend, e.g. https://you.github.io
CORS_ORIGINS=

# Photon control endpoint provided by snakeone. Keep blank for dashboard simulation.
PHOTON_BRIDGE_URL=
# Required for the loopback-only Even relay endpoint. Use the same local value in the relay.
WINGMAN_SHARED_SECRET=

# Optional Twilio call escalation. Leave blank to keep calling disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS URL to backend/app/static/wingman-call.wav (or your own WAV/MP3).
CALL_AUDIO_URL=

# StepFun Step Plan: cloud Agent brain (never commit the real key)
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_AGENT_MODEL=step-3.5-flash
STEPFUN_REALTIME_URL=wss://api.stepfun.com/step_plan/v1/realtime
STEPFUN_AUDIO_MODEL=stepaudio-2.5-realtime

# DimOS MCP and Go2 AP mode
DIMOS_MCP_URL=http://127.0.0.1:9990/mcp
ROBOT_IP=192.168.12.1
UNITREE_AES_128_KEY=

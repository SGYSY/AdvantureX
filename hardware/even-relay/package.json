{
  "name": "even-r1-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests --exclude \"tests/*.test.mjs\"",
    "test:tools": "node --test tools/*.test.mjs",
    "preview": "vite preview",
    "pack": "evenhub pack app.json dist -o out.ehpk",
    "relay": "node --env-file=.env tools/relay-server.mjs",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.8.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
